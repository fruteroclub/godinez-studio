{
  "name": "@godinez/api",
  "version": "0.1.0",
  "private": true,
  "description": "Godinez Studio API — Hono + Drizzle + PostgreSQL",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@clerk/backend": "^1.20.0",
    "@godinez/db": "workspace:*",
    "@godinez/types": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "postgres": "^3.4.0",
    "svix": "^1.86.0",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  }
}
