{
  "name": "@godinez/api",
  "version": "0.1.0",
  "private": true,
  "description": "Godinez Studio API — Hono + Drizzle + PostgreSQL",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "set -a && . ./.env.local && set +a && drizzle-kit generate",
    "db:push": "set -a && . ./.env.local && set +a && drizzle-kit push",
    "db:push:dev": "set -a && . ./.env.development && set +a && drizzle-kit push",
    "db:studio": "set -a && . ./.env.local && set +a && drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@clerk/backend": "^1.20.0",
    "@godinez/db": "workspace:*",
    "@godinez/types": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/node": "^10.42.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.0",
    "stripe": "^21.0.0",
    "svix": "^1.86.0",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
